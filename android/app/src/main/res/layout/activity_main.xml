<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="match_parent">
 <TextView android:text="VirtualPhone" android:textSize="28sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 <EditText android:id="@+id/server" android:hint="Server URL, e.g. ws://192.168.1.5:8080" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <EditText android:id="@+id/userId" android:hint="Your user ID" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <EditText android:id="@+id/peerId" android:hint="Friend user ID" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <Button android:id="@+id/connect" android:text="CONNECT" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <Button android:id="@+id/call" android:text="CALL" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <Button android:id="@+id/hang" android:text="HANG UP" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <TextView android:id="@+id/status" android:text="Disconnected" android:paddingTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
